---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import groteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo, { type SeoImage } from '../components/Seo.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { manifestPath } from '../lib/manifest';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  image: SeoImage;
  /** The same page in each language. Omit for single-language pages (404). */
  alternates?: Record<Lang, string>;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  isHome?: boolean;
}

const { lang, alternates, isHome = false, ...seo } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
const switchTo = alternates?.[otherLang] ?? (otherLang === 'en' ? '/' : '/es/');
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={groteskLatin} as="font" type="font/woff2" crossorigin />
    <Seo lang={lang} alternates={alternates} {...seo} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href={manifestPath(lang)} />
    <meta name="theme-color" content="#0b0c10" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body id="top" class="text-fg">
    <a href="#main" class="skip-link">{t.a11y.skipLink}</a>
    <div class="aurora" aria-hidden="true" transition:persist="aurora"></div>
    <Header lang={lang} switchTo={switchTo} isHome={isHome} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer lang={lang} switchTo={switchTo} isHome={isHome} />

    <script>
      /**
       * The section being read right now: the last one whose top has passed a
       * line 30 % down the visible area. The URL's #hash is not enough, because
       * it keeps the last in-page jump after the visitor scrolls elsewhere. At
       * the very bottom of the page the last sections cannot reach that line, so
       * a #hash section that is on screen wins there.
       */
      function currentSection(): string | null {
        const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];
        const headerBottom = document.querySelector('header')?.getBoundingClientRect().bottom ?? 0;
        const line = headerBottom + (window.innerHeight - headerBottom) * 0.3;
        let current: HTMLElement | null = null;
        for (const section of sections) {
          if (section.getBoundingClientRect().top <= line) current = section;
        }
        const atBottom =
          window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
        const hashed = sections.find((s) => `#${s.id}` === decodeURIComponent(window.location.hash));
        if (atBottom && hashed) {
          const box = hashed.getBoundingClientRect();
          if (box.top < window.innerHeight && box.bottom > headerBottom) current = hashed;
        }
        return current?.id ?? null;
      }

      // Keep the section you are reading when switching language on the home
      // page: /#faq → /es/#faq (section ids are the same in both languages).
      // Capture phase, so the href is updated before the router reads it.
      document.addEventListener(
        'click',
        (event) => {
          const link = (event.target as Element | null)?.closest<HTMLAnchorElement>(
            'a[data-lang-switch]',
          );
          if (!link) return;
          // The server-rendered address, kept in case this link was rewritten before.
          const base = (link.dataset.baseHref ??= link.getAttribute('href') ?? '/');
          const target = new URL(base, window.location.href);
          const here = window.location.pathname.replace(/^\/es(?=\/)/, '');
          const there = target.pathname.replace(/^\/es(?=\/)/, '');
          const section = here === there ? currentSection() : null;
          link.href = section ? `${target.pathname}#${section}` : target.pathname;
        },
        true,
      );

      // Astro's router ignores history entries it did not create (a #hash typed
      // into the address bar has history.state === null). Going Back to one of
      // those from another page would change the URL but leave the other page on
      // screen, so load it for real. The router's own hash steps briefly have a
      // null state too, so this looks again once they are done.
      let shownPath = window.location.pathname;
      document.addEventListener('astro:before-swap', (event) => {
        shownPath = event.to.pathname;
      });
      window.addEventListener('popstate', (event) => {
        if (event.state !== null) return;
        setTimeout(() => {
          if (history.state === null && window.location.pathname !== shownPath) {
            window.location.reload();
          }
        });
      });
    </script>
  </body>
</html>
