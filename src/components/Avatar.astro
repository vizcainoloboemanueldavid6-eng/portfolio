---
/**
 * The hero portrait: profile.photo if there is one, otherwise a generated
 * circle with the initials. Either way it sits in the same ring, so swapping
 * in a real photo changes nothing else on the page.
 */
import { profile } from '../config/profile';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="avatar relative aspect-square w-32 sm:w-40 md:w-72 lg:w-80">
  <div class="avatar-ring absolute inset-0 rounded-full" aria-hidden="true"></div>
  <div class="absolute inset-[6px] overflow-hidden rounded-full bg-surface shadow-[0_30px_80px_-30px_rgb(124_92_255/0.8)]">
    {
      profile.photo ? (
        <img
          src={profile.photo}
          alt={label}
          width="400"
          height="400"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      ) : (
        <svg viewBox="0 0 200 200" role="img" aria-label={label} class="h-full w-full">
          <defs>
            <linearGradient id="avatar-fill" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#7c5cff" />
              <stop offset="1" stop-color="#3a2a9e" />
            </linearGradient>
            <radialGradient id="avatar-glow" cx="0.3" cy="0.2" r="0.8">
              <stop offset="0" stop-color="#ffffff" stop-opacity="0.25" />
              <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
            </radialGradient>
          </defs>
          <rect width="200" height="200" fill="url(#avatar-fill)" />
          <rect width="200" height="200" fill="url(#avatar-glow)" />
          <text
            x="100"
            y="100"
            text-anchor="middle"
            dominant-baseline="central"
            fill="#ffffff"
            font-size="76"
            font-weight="700"
            font-family="'Space Grotesk Variable', 'Space Grotesk Fallback', sans-serif"
            letter-spacing="-2">{profile.initials}</text
          >
        </svg>
      )
    }
  </div>
  <span class="avatar-dot absolute bottom-[8%] right-[8%] h-[12%] w-[12%] rounded-full border-4 border-ink bg-secondary" aria-hidden="true"></span>
</div>

<style>
  .avatar-ring {
    background: conic-gradient(
      from 0deg,
      var(--color-primary),
      var(--color-secondary),
      var(--color-primary-deep),
      var(--color-primary)
    );
    animation: spin 14s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }
</style>
