---
import { profile, type ServiceId } from '../../config/profile';
import type { Lang } from '../../i18n/ui';
import { fill, formatPrice, useTranslations } from '../../i18n/utils';
import Icon, { type IconName } from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const order: { id: ServiceId; icon: IconName }[] = [
  { id: 'websites', icon: 'browser' },
  { id: 'extensions', icon: 'puzzle' },
  { id: 'webapps', icon: 'dashboard' },
];
---

<section id="services" class="container-page scroll-mt-24 py-16 md:py-24" aria-labelledby="services-title">
  <SectionHeading id="services-title" eyebrow={t.services.eyebrow} title={t.services.title} intro={t.services.intro} />

  <ul class="mt-12 grid gap-6 md:grid-cols-3">
    {
      order.map(({ id, icon }) => {
        const copy = t.services.items[id];
        const service = profile.services[id];
        return (
          <li class="service card flex flex-col p-7">
            <span class="service-icon" aria-hidden="true">
              <Icon name={icon} size={24} />
            </span>
            <h3 class="mt-6 text-2xl font-bold">{copy.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{copy.description}</p>
            <p class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="font-display text-3xl font-bold text-fg">
                {fill(t.services.fromPrice, { price: formatPrice(service.fromPrice, lang) })}
              </span>
              <span class="text-sm text-muted">{fill(t.services.delivery, { days: service.deliveryDays })}</span>
            </p>
            <h4 class="mt-6 text-sm font-semibold uppercase tracking-[0.12em] text-primary-soft">
              {t.services.includes}
            </h4>
            <ul class="mt-3 grid gap-2.5 text-[0.95rem]">
              {copy.features.map((feature) => (
                <li class="flex items-start gap-2.5">
                  <Icon name="check" size={18} class="mt-0.5 shrink-0 text-secondary" />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <div class="mt-auto pt-8">
              <a href={service.gigUrl} target="_blank" rel="noopener" class="btn btn-ghost w-full justify-between">
                <span>
                  {t.services.cta}
                  <span class="sr-only">
                    : {copy.title} {t.a11y.opensNewTab}
                  </span>
                </span>
                <Icon name="arrow-up-right" size={18} />
              </a>
            </div>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .service {
    transition:
      transform 0.35s var(--ease-out-soft),
      border-color 0.3s ease;
  }

  .service:hover {
    transform: translateY(-4px);
    border-color: rgb(124 92 255 / 0.4);
  }

  .service-icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.9rem;
    color: var(--color-primary-soft);
    background: rgb(124 92 255 / 0.12);
    border: 1px solid rgb(124 92 255 / 0.35);
  }
</style>
