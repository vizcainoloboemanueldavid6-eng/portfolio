---
/**
 * No contact form on purpose: Fiverr's rules keep orders and payments on the
 * platform, so the main call to action is always Fiverr. Email and GitHub are
 * there for questions and code samples.
 */
import { profile } from '../../config/profile';
import type { Lang } from '../../i18n/ui';
import { fill, useTranslations } from '../../i18n/utils';
import { brandIcon } from '../../lib/icons';
import BrandIcon from '../BrandIcon.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="container-page py-16 md:py-24" aria-labelledby="contact-title">
  <div class="contact card overflow-hidden px-6 py-14 text-center sm:px-12 md:py-20">
    <p class="eyebrow justify-center">{t.contact.eyebrow}</p>
    <h2 id="contact-title" class="mx-auto mt-4 max-w-2xl text-4xl font-bold leading-tight sm:text-5xl">
      {t.contact.title}
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-muted">{fill(t.contact.text)}</p>

    <div class="mt-10 flex justify-center">
      <a href={profile.links.fiverr} target="_blank" rel="noopener" class="btn btn-primary btn-lg">
        {t.contact.fiverr}
        <span class="sr-only">{t.a11y.opensNewTab}</span>
        <Icon name="arrow-up-right" size={18} />
      </a>
    </div>

    <ul class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <li>
        <a href={`mailto:${profile.email}`} class="btn btn-ghost">
          <Icon name="mail" size={18} />
          <span><span class="sr-only">{t.contact.email}: </span>{profile.email}</span>
        </a>
      </li>
      <li>
        <a href={profile.links.github} target="_blank" rel="noopener" class="btn btn-ghost">
          <BrandIcon icon={brandIcon('github')} size={18} />
          {t.contact.github}
          <span class="text-muted">@{profile.username}</span>
          <span class="sr-only">{t.a11y.opensNewTab}</span>
        </a>
      </li>
    </ul>
    <p class="mx-auto mt-6 max-w-md text-sm text-muted">{t.contact.note}</p>
  </div>
</section>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    border-color: rgb(124 92 255 / 0.35);
    background:
      radial-gradient(60% 80% at 50% 0%, rgb(124 92 255 / 0.22), transparent 70%),
      radial-gradient(40% 60% at 90% 100%, rgb(46 230 166 / 0.1), transparent 70%),
      var(--color-surface);
  }
</style>
