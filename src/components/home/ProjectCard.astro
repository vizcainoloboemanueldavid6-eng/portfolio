---
import type { Lang } from '../../i18n/ui';
import { localizePath, useTranslations } from '../../i18n/utils';
import type { Project } from '../../lib/projects';
import Icon from '../Icon.astro';
import ProjectImage from '../ProjectImage.astro';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const { data, slug } = project;
const href = localizePath(lang, `/projects/${slug}/`);
const sizes = data.featured
  ? '(min-width: 1152px) 540px, (min-width: 768px) 46vw, 92vw'
  : '(min-width: 1152px) 356px, (min-width: 768px) 46vw, 92vw';
---

<li class:list={['project-item', data.featured ? 'lg:col-span-3' : 'lg:col-span-2']} data-type={data.type}>
  <article class="card project-card h-full overflow-hidden">
    <div class="project-media relative aspect-[16/10] overflow-hidden border-b border-line bg-surface-2">
      <ProjectImage
        src={data.cover}
        alt={data.coverAlt}
        sizes={sizes}
        class="project-cover h-full w-full object-cover object-top"
        transitionName={`cover-${slug}`}
      />
      <div class="project-stack">
        <ul class="flex flex-wrap gap-1.5" aria-label={t.work.builtWith}>
          {data.stack.slice(0, 6).map((tech) => <li class="chip">{tech}</li>)}
        </ul>
      </div>
    </div>
    <div class="flex flex-col p-6">
      <div class="flex flex-wrap gap-2">
        <span class="badge badge-personal">{t.work.personalProject}</span>
        <span class="badge badge-type">{t.work.types[data.type]}</span>
      </div>
      <h3 class="mt-4 text-2xl font-bold">
        <a href={href} class="card-link">{data.title}</a>
      </h3>
      <p class="mt-1 text-sm font-medium text-primary-soft">{data.tagline}</p>
      <p class="mt-3 leading-relaxed text-muted">{data.summary}</p>
      <p class="mt-5 inline-flex items-center gap-2 font-semibold text-fg" aria-hidden="true">
        {t.work.readCase}
        <Icon name="arrow-right" size={18} class="read-arrow" />
      </p>
    </div>
  </article>
</li>

<style>
  .project-card {
    transition:
      transform 0.35s var(--ease-out-soft),
      border-color 0.3s ease,
      box-shadow 0.35s ease;
  }

  .project-card:hover,
  .project-card:focus-within {
    transform: translateY(-6px);
    border-color: rgb(124 92 255 / 0.5);
    box-shadow: 0 28px 60px -28px rgb(124 92 255 / 0.6);
  }

  /* The whole card is clickable; the link keeps the title as its name. */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card-link:focus-visible {
    outline: none;
  }

  .project-card:has(.card-link:focus-visible) {
    outline: 2px solid var(--color-primary-soft);
    outline-offset: 4px;
  }

  /* .project-cover and .read-arrow are rendered by child components, hence :global. */
  .project-card :global(.project-cover) {
    transition: transform 0.6s var(--ease-out-soft);
  }

  .project-card:hover :global(.project-cover) {
    transform: scale(1.035);
  }

  .project-card :global(.read-arrow) {
    transition: transform 0.3s var(--ease-out-soft);
  }

  .project-card:hover :global(.read-arrow) {
    transform: translateX(4px);
  }

  .project-stack {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 2.75rem 1rem 1rem;
    background: linear-gradient(to top, rgb(11 12 16 / 0.94), rgb(11 12 16 / 0.6) 60%, transparent);
  }

  /* With a mouse, the stack slides in on hover or keyboard focus; on touch it is always shown. */
  @media (hover: hover) and (pointer: fine) {
    .project-stack {
      opacity: 0;
      transform: translateY(0.75rem);
      transition:
        opacity 0.3s ease,
        transform 0.4s var(--ease-out-soft);
    }

    .project-card:hover .project-stack,
    .project-card:focus-within .project-stack {
      opacity: 1;
      transform: none;
    }
  }
</style>
