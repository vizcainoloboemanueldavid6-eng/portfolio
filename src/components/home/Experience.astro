---
/**
 * The experience section lists the portfolio projects only, each labelled as
 * a personal project. There is deliberately no employer, client or date here:
 * nothing on this site claims work that did not happen.
 */
import type { Lang } from '../../i18n/ui';
import { localizePath, useTranslations } from '../../i18n/utils';
import type { Project } from '../../lib/projects';
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  lang: Lang;
  projects: Project[];
}

const { lang, projects } = Astro.props;
const t = useTranslations(lang);
---

<section id="experience" class="container-page py-16 md:py-24" aria-labelledby="experience-title">
  <SectionHeading
    id="experience-title"
    eyebrow={t.experience.eyebrow}
    title={t.experience.title}
    intro={t.experience.intro}
  />

  <ol class="timeline mt-12 grid gap-4">
    {
      projects.map(({ slug, data }) => (
        <li class="timeline-item relative pl-10">
          <span class="timeline-dot" aria-hidden="true" />
          <div class="card grid gap-4 p-5 sm:grid-cols-[1fr_auto] sm:items-center sm:p-6">
            <div>
              <div class="flex flex-wrap gap-2">
                <span class="badge badge-personal">{t.work.personalProject}</span>
                <span class="badge badge-type">{t.work.types[data.type]}</span>
              </div>
              <h3 class="mt-3 text-xl font-bold">
                {data.title}
                <span class="font-sans text-base font-normal text-muted"> · {data.tagline}</span>
              </h3>
              <p class="mt-1.5 text-sm text-muted">
                {t.experience.role} · {data.stack.slice(0, 4).join(' · ')}
              </p>
            </div>
            <a
              href={localizePath(lang, `/projects/${slug}/`)}
              class="inline-flex items-center gap-2 self-start rounded-full text-sm font-semibold text-primary-soft hover:text-fg sm:self-center"
            >
              {t.work.readCase}
              <span class="sr-only">: {data.title}</span>
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .timeline {
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0.6rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(var(--color-primary), var(--color-secondary));
    opacity: 0.5;
  }

  .timeline-dot {
    position: absolute;
    left: 0.2rem;
    top: 1.75rem;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--color-ink);
    border: 2px solid var(--color-primary-soft);
  }
</style>
