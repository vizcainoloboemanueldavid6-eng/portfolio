---
import type { Lang } from '../../i18n/ui';
import { fill, useTranslations } from '../../i18n/utils';
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="faq" class="container-page py-16 md:py-24" aria-labelledby="faq-title">
  <div class="grid gap-12 lg:grid-cols-[1fr_1.6fr]">
    <SectionHeading id="faq-title" eyebrow={t.faq.eyebrow} title={t.faq.title} />

    <div class="grid gap-3">
      {
        t.faq.items.map((item) => (
          <details class="faq card group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 p-5 text-left sm:p-6">
              <h3 class="text-lg font-semibold">{item.q}</h3>
              <span class="faq-toggle" aria-hidden="true">
                <Icon name="plus" size={18} />
              </span>
            </summary>
            <div class="px-5 pb-6 sm:px-6">
              <p class="leading-relaxed text-muted">{fill(item.a)}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  .faq {
    border-radius: 1rem;
    transition: border-color 0.25s ease;
  }

  .faq[open] {
    border-color: rgb(124 92 255 / 0.45);
  }

  .faq summary:focus-visible {
    outline-offset: -2px;
    border-radius: 1rem;
  }

  .faq-toggle {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid var(--color-line-strong);
    color: var(--color-primary-soft);
    transition: transform 0.3s var(--ease-out-soft);
  }

  .faq[open] .faq-toggle {
    transform: rotate(45deg);
  }
</style>
