---
import { profile } from '../../config/profile';
import type { Lang } from '../../i18n/ui';
import { fill, useTranslations } from '../../i18n/utils';
import Avatar from '../Avatar.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const title = fill(t.hero.title);
const [greeting, pitch] = title.includes(' — ') ? title.split(' — ') : [title, ''];
---

<section class="relative isolate" aria-labelledby="hero-title">
  <div class="grid-fade pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div
    class="container-page grid items-center gap-10 pb-20 pt-12 md:grid-cols-[1.5fr_1fr] md:gap-12 md:pb-28 md:pt-24"
  >
    <div>
      {
        profile.available && (
          <p class="badge badge-personal mb-6 px-3 py-1 text-[0.8rem]">
            <span class="status-dot" aria-hidden="true" />
            {t.hero.available}
          </p>
        )
      }
      <h1
        id="hero-title"
        class="text-[2.35rem] font-bold leading-[1.06] sm:text-5xl lg:text-[4rem]"
      >
        {greeting}{pitch && ' — '}{pitch && <span class="text-gradient">{pitch}</span>}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted sm:text-xl">{t.hero.subtitle}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={profile.links.fiverr} target="_blank" rel="noopener" class="btn btn-primary btn-lg">
          {t.hero.ctaPrimary}
          <span class="sr-only">{t.a11y.opensNewTab}</span>
          <Icon name="arrow-up-right" size={18} />
        </a>
        <a href="#work" class="btn btn-ghost btn-lg">
          {t.hero.ctaSecondary}
          <Icon name="arrow-down" size={18} />
        </a>
      </div>
      <ul class="mt-10 grid gap-3 text-sm text-muted sm:grid-cols-3 sm:gap-4">
        {
          t.hero.points.map((point) => (
            <li class="flex items-start gap-2">
              <Icon name="check" size={18} class="mt-px shrink-0 text-secondary" />
              <span>{fill(point)}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="order-first flex justify-start md:order-none md:justify-end">
      <Avatar label={fill(t.hero.avatarLabel)} />
    </div>
  </div>
</section>

<style>

  .status-dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-secondary);
  }

  /* transform + opacity only, so the pulse runs on the compositor */
  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-secondary);
    animation: ping 2.4s ease-out infinite;
  }

  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    80%,
    100% {
      transform: scale(2.8);
      opacity: 0;
    }
  }
</style>
