---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="process" class="container-page py-16 md:py-24" aria-labelledby="process-title">
  <SectionHeading id="process-title" eyebrow={t.process.eyebrow} title={t.process.title} intro={t.process.intro} />

  <ol class="steps mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
    {
      t.process.steps.map((step, index) => (
        <li class="step card p-6">
          <span class="step-number font-display" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-5 text-xl font-bold">{step.title}</h3>
          <p class="mt-3 leading-relaxed text-muted">{step.text}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .step-number {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-ink);
    background: linear-gradient(135deg, var(--color-secondary), #8ef5d0);
    box-shadow: 0 10px 30px -12px rgb(46 230 166 / 0.7);
  }

  @media (min-width: 1024px) {
    .step {
      position: relative;
    }

    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 3rem;
      right: -1.5rem;
      width: 1.5rem;
      height: 2px;
      background: linear-gradient(90deg, var(--color-secondary), transparent);
      opacity: 0.6;
    }
  }
</style>
