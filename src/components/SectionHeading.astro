---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
}

const { id, eyebrow, title, intro, align = 'left' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="mt-4 text-3xl font-bold leading-tight sm:text-4xl">{title}</h2>
  {intro && <p class="mt-4 text-lg leading-relaxed text-muted">{intro}</p>}
</div>
