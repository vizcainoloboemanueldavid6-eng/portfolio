---
import { languages, type Lang } from '../i18n/ui';
import { fill, useTranslations } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  /** The equivalent page in the other language. */
  href: string;
  /** Two-letter label on phones, where the header is tight. */
  compact?: boolean;
  class?: string;
}

const { lang, href, compact = false, class: className = '' } = Astro.props;
const other: Lang = lang === 'en' ? 'es' : 'en';
const title = fill(useTranslations(other).a11y.switchTo, { language: languages[other] });
---

<a
  href={href}
  hreflang={other}
  lang={other}
  title={title}
  data-lang-switch
  class:list={[
    'inline-flex min-h-10 items-center gap-1.5 rounded-full border border-line px-2.5 py-2 text-sm font-medium text-fg transition-colors hover:border-primary-soft/60 hover:bg-white/5 sm:px-3',
    className,
  ]}
>
  <Icon name="globe" size={16} />
  {
    compact ? (
      <>
        <span class="uppercase sm:hidden" aria-hidden="true">
          {other}
        </span>
        <span class="max-sm:sr-only">{languages[other]}</span>
      </>
    ) : (
      <span>{languages[other]}</span>
    )
  }
</a>
