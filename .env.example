# Public address of the deployed site, without a trailing slash.
# Canonical URLs, hreflang, Open Graph, the sitemap, robots.txt and the JSON-LD all use it.
# On Vercel you can leave it unset: the build falls back to VERCEL_PROJECT_PRODUCTION_URL.
# TODO: replace with your real domain
SITE_URL=https://mateobuilds.example.com
